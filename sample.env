# Common Environment Configuration for Vanna 2.0 Samples
# Copy this file to .env at the repository root or inside each sample folder.

# -------------------------------------------------------------
# Active Database Selector: 'duckdb' | 'snowflake' | 'postgres'
# -------------------------------------------------------------
DATABASE_TYPE=duckdb

# 1. DuckDB Configuration (Embedded / Local / Fast Analytics)
DUCKDB_PATH=
DUCKDB_READ_ONLY=false

# 2. Snowflake Database Configuration (Cloud Data Warehouse)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=ADVENTUREWORKS  # ADVENTUREWORKS, DVDRENTAL, or SEI_DEMO
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=

# 3. PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=AdventureWorksOLTP

# -------------------------------------------------------------
# Active Vector Store Selector: 'qdrant' | 'chromadb' | 'faiss'
# -------------------------------------------------------------
VECTOR_STORE=qdrant
VECTOR_PERSIST_DIR=./vector_store

# 1. Qdrant Cloud / Managed Service
# Endpoint example: https://<cluster-id>.<region>.gcp.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# 2. ChromaDB (Local persistent vector store)
# Uses VECTOR_PERSIST_DIR above

# 3. FAISS (High-performance in-memory / local index)
# Uses VECTOR_PERSIST_DIR above

# -------------------------------------------------------------
# Azure OpenAI Configuration
# -------------------------------------------------------------
LLM_ENV=openai
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
