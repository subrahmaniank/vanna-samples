# Active Database Selector: 'duckdb' | 'snowflake' | 'postgres'
DATABASE_TYPE=duckdb

# DuckDB Configuration
DUCKDB_PATH=adventureworks.duckdb
DUCKDB_READ_ONLY=false

# Snowflake Database Configuration
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=ADVENTUREWORKS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=AdventureWorksOLTP

# Active Vector Store Selector: 'qdrant' | 'chromadb' | 'faiss'
VECTOR_STORE=qdrant
VECTOR_PERSIST_DIR=./aw_vector_store

# Qdrant Cloud / Service Settings
# Endpoint example: https://<cluster-id>.<region>.gcp.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=

# LLM Settings (Azure OpenAI)
LLM_ENV=openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview