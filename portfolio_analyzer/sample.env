# =============================================================
# Portfolio Analyzer - Environment Configuration (Vanna 2.0)
# =============================================================

# Active Database Selector: 'duckdb' | 'snowflake' | 'postgres'
DATABASE_TYPE=duckdb

# 1. DuckDB Configuration (Local database inside this folder)
DUCKDB_PATH=sei_demo.duckdb
DUCKDB_READ_ONLY=false

# 2. Snowflake Database Configuration
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=SEI_DEMO
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=

# 3. PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=sei_demo

# -------------------------------------------------------------
# Active Vector Store Selector: 'qdrant' | 'chromadb' | 'faiss'
# -------------------------------------------------------------
VECTOR_STORE=qdrant
VANNA_MAX_TOOL_ITERATIONS=25
VECTOR_PERSIST_DIR=./vector_store

# 1. Qdrant Cloud / Managed Service
QDRANT_URL=
QDRANT_API_KEY=

# -------------------------------------------------------------
# Active LLM Provider Selector: 'openrouter' | 'bedrock_mantle' | 'azure_openai' | 'openai'
# -------------------------------------------------------------
LLM_PROVIDER=openrouter

# 1. OpenRouter (Unified API endpoint - https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://vanna.ai
OPENROUTER_APP_NAME=Portfolio Analyzer

# 2. AWS Bedrock Mantle Endpoint (Native OpenAI-compatible distributed inference)
BEDROCK_MANTLE_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MANTLE_API_KEY=
BEDROCK_MANTLE_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_REGION=us-east-1
BEDROCK_MANTLE_PROJECT_ID=

# 3. Azure OpenAI Configuration (Alternative)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# 4. Standard OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
