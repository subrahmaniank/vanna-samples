DATABASE_TYPE=duckdb
DUCKDB_PATH=auto_finance.duckdb
DUCKDB_READ_ONLY=true
VANNA_MAX_TOOL_ITERATIONS=25

# Use the same remote Qdrant service as the other samples, with separate collections.
VECTOR_STORE=qdrant
# Use https://<cluster-host>:443 when your network blocks Qdrant's port 6333.
QDRANT_URL=
QDRANT_API_KEY=

# -------------------------------------------------------------
# Active LLM Provider Selector: 'openrouter' | 'custom' | 'bedrock_mantle' | 'azure_openai' | 'openai'
# -------------------------------------------------------------
LLM_PROVIDER=openrouter

# 1. OpenRouter (Unified API endpoint - https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Auto Finance Analysis

# 2. AWS Bedrock Mantle (OpenAI-compatible endpoint)
# Endpoint example: https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MANTLE_ENDPOINT=
BEDROCK_MANTLE_API_KEY=
BEDROCK_MANTLE_MODEL=
AWS_REGION=us-east-1
BEDROCK_MANTLE_PROJECT_ID=

# 3. Azure OpenAI Configuration (Alternative)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=

# 4. Standard OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# 5. Custom OpenAI Chat Completions-compatible endpoint (vLLM, LiteLLM, corporate gateway, etc.)
# LLM_PROVIDER=custom
# CUSTOM_LLM_BASE_URL=https://your-host/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=your-model-id
# CUSTOM_LLM_APPEND_V1=true
# Set CUSTOM_LLM_APPEND_V1=false when the base URL already includes /v1 or uses a non-root API path.
