DATABASE_TYPE=duckdb
DUCKDB_PATH=auto_finance.duckdb
DUCKDB_READ_ONLY=true
VANNA_MAX_TOOL_ITERATIONS=25

# Use the same remote Qdrant service as the other samples, with separate collections.
VECTOR_STORE=qdrant
# Use https://<cluster-host>:443 when your network blocks Qdrant's port 6333.
QDRANT_URL=
QDRANT_API_KEY=

# Select and configure one LLM provider.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Auto Finance Analysis

# Alternatives: bedrock_mantle, azure_openai, openai.
BEDROCK_MANTLE_ENDPOINT=
BEDROCK_MANTLE_API_KEY=
BEDROCK_MANTLE_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_VERSION=
OPENAI_API_KEY=
OPENAI_MODEL=
